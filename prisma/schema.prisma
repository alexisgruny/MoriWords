// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SourceText {
  id             String   @id @default(cuid())
  content        String   @db.Text
  title          String?
  origin         String?
  category       String?
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  sourceUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tokens          Token[]
  wordOccurrences WordOccurrence[]
}

model Token {
  id             String      @id @default(cuid())
  sourceTextId   String
  sourceText     SourceText  @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)

  surface        String
  lemma          String?
  reading        String?
  partOfSpeech   String?
  position       Int
  isParticle     Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([sourceTextId, position])
}

model VocabularyEntry {
  id             String   @id @default(cuid())
  lemma          String
  surface        String?
  reading        String?
  partOfSpeech   String?
  difficulty     String   @default("N5")
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  occurrenceCount Int     @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([lemma, sourceLanguage, targetLanguage])
  @@index([sourceLanguage, targetLanguage, occurrenceCount])
  @@index([difficulty, occurrenceCount])
}

model Deck {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards Card[]
}

model Card {
  id             String   @id @default(cuid())
  deckId         String
  deck           Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  lemma          String
  surface        String?
  reading        String?
  meaning        String?
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  repetitions    Int      @default(0)
  interval       Int      @default(0)
  easeFactor     Float    @default(2.5)
  dueAt          DateTime @default(now())
  createdAt      DateTime @default(now())

  imageUrl         String?
  imageAttribution String?
  audioCacheId     String?
  audioCache       AudioCache? @relation(fields: [audioCacheId], references: [id], onDelete: SetNull)

  occurrences WordOccurrence[]
  reviewLogs  ReviewLog[]

  @@unique([deckId, lemma, sourceLanguage, targetLanguage])
  @@index([deckId, lemma])
  @@index([deckId, dueAt])
}

model AudioCache {
  id        String   @id @default(cuid())
  text      String
  language  String
  voice     String
  audioData Bytes
  mimeType  String   @default("audio/mpeg")
  createdAt DateTime @default(now())

  cards Card[]

  @@unique([text, language, voice])
}

model ImageCache {
  id          String   @id @default(cuid())
  query       String   @unique
  imageUrl    String
  attribution String?
  createdAt   DateTime @default(now())
}

model WordOccurrence {
  id           String      @id @default(cuid())
  cardId       String
  card         Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  sourceTextId String?
  sourceText   SourceText? @relation(fields: [sourceTextId], references: [id], onDelete: SetNull)
  position     Int?
  createdAt    DateTime    @default(now())

  @@unique([cardId, sourceTextId])
  @@index([cardId])
  @@index([sourceTextId])
}

model ReviewLog {
  id           String   @id @default(cuid())
  cardId       String
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quality      Int
  interval     Int
  easeFactor   Float
  repetitions  Int
  reviewedAt   DateTime @default(now())

  @@index([cardId, reviewedAt])
}

model TranslationCache {
  id             String   @id @default(cuid())
  lemma          String
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  translation    String
  explanation    String
  difficulty     String   @default("N5")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([lemma, sourceLanguage, targetLanguage])
  @@index([sourceLanguage, targetLanguage, lemma])
  @@index([difficulty, lemma])
}