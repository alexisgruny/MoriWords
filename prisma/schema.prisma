// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SourceText {
  id             String   @id @default(cuid())
  content        String   @db.Text
  title          String?
  origin         String?
  category       String?
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  sourceUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Propriétaire du texte. Optionnel : les textes créés avant les comptes
  // n'en ont pas jusqu'à leur rattachement (voir src/lib/auth/auth.ts).
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokens          Token[]
  wordOccurrences WordOccurrence[]

  @@index([userId])
}

model Token {
  id             String      @id @default(cuid())
  sourceTextId   String
  sourceText     SourceText  @relation(fields: [sourceTextId], references: [id], onDelete: Cascade)

  surface        String
  lemma          String?
  reading        String?
  partOfSpeech   String?
  position       Int
  isParticle     Boolean     @default(false)
  createdAt      DateTime    @default(now())

  @@index([sourceTextId, position])
}

model VocabularyEntry {
  id             String   @id @default(cuid())
  lemma          String
  surface        String?
  reading        String?
  partOfSpeech   String?
  difficulty     String   @default("N5")
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  occurrenceCount Int     @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Chaque compte a son propre vocabulaire (mots rencontrés dans ses textes).
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lemma, sourceLanguage, targetLanguage])
  @@index([sourceLanguage, targetLanguage, occurrenceCount])
  @@index([difficulty, occurrenceCount])
}

model Deck {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Propriétaire du deck (ses cartes suivent). Optionnel pour la même raison
  // que SourceText.userId.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  cards Card[]

  @@index([userId])
}

model Card {
  id             String   @id @default(cuid())
  deckId         String
  deck           Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  lemma          String
  surface        String?
  reading        String?
  meaning        String?
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  repetitions    Int      @default(0)
  interval       Int      @default(0)
  easeFactor     Float    @default(2.5)
  dueAt          DateTime @default(now())
  createdAt      DateTime @default(now())

  occurrences WordOccurrence[]
  reviewLogs  ReviewLog[]
  examples    CardExample[]

  // Un seul mot par deck : ajouter un mot déjà présent met à jour la carte
  // existante (voir POST .../cards) au lieu d'en créer une deuxième.
  @@unique([deckId, lemma, sourceLanguage, targetLanguage])
  @@index([deckId, lemma])
  @@index([deckId, dueAt])
}

model WordOccurrence {
  id           String      @id @default(cuid())
  cardId       String
  card         Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  sourceTextId String?
  sourceText   SourceText? @relation(fields: [sourceTextId], references: [id], onDelete: SetNull)
  position     Int?
  createdAt    DateTime    @default(now())

  // Un seul enregistrement par (carte, texte) : revoir le même mot plusieurs
  // fois dans un même texte ne crée pas de doublon, seule la première
  // position rencontrée est gardée.
  @@unique([cardId, sourceTextId])
  @@index([cardId])
  @@index([sourceTextId])
}

model ReviewLog {
  id           String   @id @default(cuid())
  cardId       String
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  quality      Int
  interval     Int
  easeFactor   Float
  repetitions  Int
  reviewedAt   DateTime @default(now())

  @@index([cardId, reviewedAt])
}

model TranslationCache {
  id             String   @id @default(cuid())
  lemma          String
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  translation    String
  explanation    String
  difficulty     String   @default("N5")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([lemma, sourceLanguage, targetLanguage])
  @@index([sourceLanguage, targetLanguage, lemma])
  @@index([difficulty, lemma])
}
// Phrase d'exemple simple (au niveau du mot) générée pour une carte à son ajout au deck.
model CardExample {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  japanese    String
  reading     String?
  translation String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([cardId])
}

// Phrase à traduire (français -> japonais) pour un point de grammaire, avec sa
// traduction de référence. Générée par Claude puis réutilisée sans nouvel appel.
model GrammarExercise {
  id        String   @id @default(cuid())
  pointId   String
  level     String
  french    String
  japanese  String
  createdAt DateTime @default(now())

  @@index([pointId])
}

// Correction (verdict, explication...) déjà obtenue de Claude pour une
// réponse donnée à un exercice donné. answerKey est la réponse normalisée
// (espaces et ponctuation finale ignorées) : si le même exercice revient
// (pool fini d'exemples) et que la réponse est la même, on réutilise cette
// correction au lieu de rappeler Claude.
model ExerciseCorrectionCache {
  id         String   @id @default(cuid())
  exerciseId String
  answerKey  String
  correction Json
  createdAt  DateTime @default(now())

  @@unique([exerciseId, answerKey])
}

// Phrases d'exemple déjà générées pour un mot (indépendamment de toute
// carte précise) : un même mot ajouté dans deux decks différents recevrait
// sinon deux jeux de phrases quasi identiques, payés deux fois à Claude.
model LemmaExampleCache {
  id             String   @id @default(cuid())
  lemma          String
  sourceLanguage String   @default("ja")
  targetLanguage String   @default("fr")
  examples       Json
  createdAt      DateTime @default(now())

  @@unique([lemma, sourceLanguage, targetLanguage])
}

// Compteurs de limitation (une ligne par clé et par fenêtre de temps) :
// requêtes par IP sur les routes coûteuses, et budget global d'appels
// réels à Claude (voir src/lib/security/). En base plutôt qu'en mémoire,
// parce que les fonctions serverless de Vercel ne partagent pas la mémoire.
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Historique des tentatives d'exercice (grammaire/conjugaison/kanji/mon
// vocabulaire), pour calculer un taux de réussite par point/forme/kanji/mot
// et repérer ce qui mérite d'être revu (page /exercices/stats). Écrit après
// chaque correction, jamais relu pour la correction elle-même (voir
// ExerciseCorrectionCache, qui a un rôle différent).
model ExerciseAttempt {
  id        String   @id @default(cuid())
  source    String
  focus     String
  level     String?
  correct   Boolean
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([source, focus])
  @@index([createdAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Comptes utilisateurs (Better Auth, voir src/lib/auth/auth.ts). Noms et
// champs imposés par la librairie : ne pas les renommer.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  decks            Deck[]
  sourceTexts      SourceText[]
  exerciseAttempts ExerciseAttempt[]
  vocabularyEntries VocabularyEntry[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// Une ligne par moyen de connexion d'un utilisateur : "credential" (email +
// mot de passe, haché par la librairie) ou "google".
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
